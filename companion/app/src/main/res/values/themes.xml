<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Puffble" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/flame</item>
        <item name="android:colorPrimary">@color/flame</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:alertDialogTheme">@style/Theme.Puffble.Dialog</item>
    </style>

    <style name="Theme.Puffble.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/flame</item>
        <item name="android:windowBackground">@drawable/card_bg</item>
    </style>

    <style name="StepTitle">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StepBody">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="PillButton">
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="LinkText">
        <item name="android:textColor">@color/flame_core</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
</resources>
